{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.0",
        "botble/media": "*",
        "botble/support": "*",
        "buzz/laravel-google-captcha": "^2.3",
        "darryldecode/cart": "^4.2",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "f9webltd/laravel-meta": "^4.0",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "^7.0.1",
        "harimayco/laravel-menu": "*",
        "html2text/html2text": "^4.3",
        "intervention/image": "^2.5",
        "jenssegers/agent": "^2.6",
        "kalnoy/nestedset": "^6.0.4",
        "laravel/framework": "^12.60",
        "laravel/legacy-factories": "^1.4",
        "laravel/passport": "^13.10",
        "laravel/scout": "^10.0",
        "laravel/socialite": "^5.0",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "maatwebsite/excel": "^3.1",
        "nicolaslopezj/searchable": "1.*",
        "orangehill/iseed": "^3.0",
        "peidgnad/tag-wrapper": "dev-master",
        "predis/predis": "^2.0",
        "propaganistas/laravel-phone": "^5.0",
        "rap2hpoutre/laravel-log-viewer": "^2.4",
        "spatie/laravel-image-optimizer": "^1.8",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-missing-page-redirector": "^2.10",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-responsecache": "^7.5",
        "spatie/laravel-tags": "^4.6",
        "tucker-eric/eloquentfilter": "^3.4",
        "yadakhov/insert-on-duplicate-key": "^1.2",
        "symfony/dom-crawler": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "kitloong/laravel-migrations-generator": "^7.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "roave/security-advisories": "dev-master",
        "wnx/laravel-stats": "^2.4",
        "spatie/laravel-ignition": "^2.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "./packages/media"
        },
        {
            "type": "path",
            "url": "./packages/support"
        },
        {
            "type": "path",
            "url": "./packages/payment"
        },
        {
            "type": "path",
            "url": "./packages/menu"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ],
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
